[
  {"id": "URG-01", "name": "Deadline or countdown pressure", "category": "Urgency", "weight": 2,
   "patterns": ["\\b(offer|sale|deal|price)s?\\s+(ends?|expires?)\\b", "\\bends?\\s+(in|soon|today|tonight|at midnight)\\b", "\\b\\d{1,2}\\s*:\\s*\\d{2}(\\s*:\\s*\\d{2})?\\b", "\\b\\d+\\s*(hrs?|hours?|mins?|minutes?|secs?|seconds?)\\b.*\\b(left|remaining)\\b", "\\bhurry\\b", "\\blimited[- ]time\\b", "\\blast chance\\b", "\\btoday only\\b", "\\bact (now|fast)\\b"],
   "question": "Is the deadline real, and does the offer actually end when stated?"},
  {"id": "SCA-01", "name": "Low-stock or high-demand claim", "category": "Scarcity", "weight": 2,
   "patterns": ["\\bonly\\s+\\d+\\s+(left|remaining|in stock|available)\\b", "\\b\\d+\\s+(left|remaining)\\s+in stock\\b", "\\blow stock\\b", "\\balmost (gone|sold out)\\b", "\\bselling (fast|out)\\b", "\\b(in|high) demand\\b", "\\blimited (stock|quantit(y|ies))\\b"],
   "question": "Does the stated stock level reflect real inventory?"},
  {"id": "SOC-01", "name": "Activity or popularity notification", "category": "Social Proof", "weight": 1,
   "patterns": ["\\b\\d+\\s+(people|others|customers|shoppers|users|persons)\\b.{0,40}\\b(viewing|bought|purchased|looking|watching|added)\\b", "\\b(just|recently)\\s+(bought|purchased|ordered)\\b", "\\bpurchased\\b.{0,30}\\bago\\b", "\\bin (\\w+\\s?){1,3},\\s*[a-z ]+\\s+(bought|purchased)\\b", "\\bbest[- ]?sell(er|ing)\\b", "\\bmost popular\\b"],
   "question": "Are the activity counts and testimonials genuine and current?"},
  {"id": "MIS-01", "name": "Confirmshaming / guilt-laden decline option", "category": "Misdirection", "weight": 3,
   "patterns": ["\\bno,?\\s*thanks?,?\\s+i\\b", "\\bi\\s+(don'?t|do not)\\s+(want|like|need|care)\\b", "\\bi('d| would)? ?(rather|prefer)\\s+(pay|miss|not)\\b", "\\bfull price\\b.{0,20}\\b(no thanks|i prefer)\\b", "\\bno,? i (hate|don'?t like)\\b"],
   "question": "Does the decline option use guilt or shame to steer the choice?"},
  {"id": "SNK-01", "name": "Item or cost added without explicit action", "category": "Other (rare)", "weight": 3,
   "patterns": ["\\b(automatically |been )?added to (your )?(cart|bag|basket|order)\\b", "\\bpre-?(selected|checked|ticked)\\b", "\\b(protection plan|insurance|donation)\\b.{0,30}\\badded\\b", "\\b(service|handling|convenience|processing) fee\\b"],
   "question": "Were extra items or fees added without the consumer opting in, and is the full price shown upfront?"},
  {"id": "OBS-01", "name": "Cancellation friction", "category": "Other (rare)", "weight": 3,
   "patterns": ["\\bto cancel,?\\s*(please\\s+)?(call|contact|email|write|visit)\\b", "\\bcall (us )?to cancel\\b", "\\bcancel(lation)?s? (only )?(by|via) (phone|mail|post|email)\\b", "\\bcannot be cancell?ed online\\b"],
   "question": "Can the consumer cancel through the same medium they used to subscribe?"},
  {"id": "FOR-01", "name": "Forced registration or action", "category": "Other (rare)", "weight": 2,
   "patterns": ["\\b(must|need to|have to)\\s+(create|register|sign up|log ?in)\\b", "\\b(create|open) an account to (continue|checkout|view|see|buy)\\b", "\\bregister to (continue|view|see|unlock)\\b"],
   "question": "Is registration genuinely required to complete the task?"},
  {"id": "SUB-01", "name": "Automatic renewal or trial conversion", "category": "Other (rare)", "weight": 2,
   "patterns": ["\\bauto(matically)?[- ]?renew(s|al|ed)?\\b", "\\bfree trial\\b.{0,60}\\b(then|after|thereafter|billed|charged)\\b", "\\b(billed|charged) (monthly|annually|every)\\b.{0,40}\\bunless\\b"],
   "question": "Is the renewal disclosed clearly, with express consent and an easy way to cancel?"},
  {"id": "PRV-01", "name": "Asymmetric privacy/consent choice", "category": "Privacy choice / consent", "weight": 3, "ccpa": true,
   "patterns": ["\\bask me later\\b", "\\bmaybe later\\b", "\\bremind me later\\b", "\\baccept all\\b(?!.*\\b(reject|decline|deny|refuse)\\b)", "\\bby (continuing|using this site|browsing)\\b.{0,40}\\b(agree|consent|accept)\\b"],
   "question": "Is declining as easy as accepting (e.g. 'Accept All' paired with 'Decline All')?"},
  {"id": "PRV-02", "name": "Confusing privacy toggle / double negative", "category": "Privacy choice / consent", "weight": 3, "ccpa": true,
   "patterns": ["\\b(don'?t|do not)\\s+(not|un)", "\\bopt[- ]out of (not|un)", "\\b(yes|no)\\b.{0,15}\\bdo not sell\\b", "\\bdo not (sell|share)\\b.{0,30}\\b(yes|no|on|off)\\b"],
   "question": "Is the privacy choice phrased without double negatives so its effect is obvious?"},
  {"id": "PRV-03", "name": "Consent bundled with data selling/sharing", "category": "Privacy choice / consent", "weight": 2, "ccpa": true,
   "patterns": ["\\b(agree|consent)\\b.{0,60}\\b(sell|share|third[- ]part(y|ies)|partners)\\b", "\\b(sell|share)\\b.{0,40}\\b(personal (information|data))\\b"],
   "question": "Is consent to selling/sharing separate from consent needed to deliver the service?"}
]
