<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Audit report – DarkPatternGuard</title>
{%- set risk_word = r.risk_level.split(" ")[0] -%}
{%- set risk_colour = {"High": "#D6293E", "Medium": "#E8710A", "Low": "#C99A06", "No": "#1E8E5A"}[risk_word] -%}
<style>
  :root { --ink:#1C1F24; --muted:#5A616B; --faint:#8A9099; --line:#E3E5E8; --panel:#F4F5F7; --red:#D6293E; --green:#1E8E5A;
          --font:"Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--panel); color:var(--ink); font:15px/1.55 var(--font); }
  .page { max-width:780px; margin:32px auto; background:#fff; border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  .top { display:flex; align-items:center; gap:10px; padding:14px 28px; border-bottom:1px solid var(--line); }
  .logo { width:22px; height:22px; border-radius:5px; background:var(--red); display:grid; place-items:center; }
  .top .name { font-weight:600; }
  .top .date { margin-left:auto; color:var(--muted); font-size:13px; }
  .head { padding:28px 28px 8px; }
  h1 { font-size:13px; font-weight:600; color:var(--muted); margin:0 0 8px; }
  blockquote { margin:0; font-size:22px; line-height:1.35; font-weight:600; letter-spacing:-.01em; max-width:62ch; }
  .verdict { display:grid; grid-template-columns:repeat(3,1fr); margin:24px 28px 8px; border:1px solid var(--line); border-radius:8px; }
  .verdict > div { padding:14px 16px; }
  .verdict > div + div { border-left:1px solid var(--line); }
  .k { color:var(--muted); font-size:13px; }
  .v { font-size:17px; font-weight:600; margin-top:2px; }
  .sub { color:var(--muted); font-size:13px; margin-top:1px; font-variant-numeric:tabular-nums; }
  .pill { display:inline-block; padding:2px 10px; border-radius:12px; color:#fff; font-size:13px; font-weight:600; }
  section { padding:20px 28px; border-top:1px solid var(--line); }
  section:first-of-type { border-top:0; }
  h2 { font-size:16px; margin:0 0 4px; }
  .lead { color:var(--muted); font-size:14px; margin:0 0 14px; max-width:68ch; }
  .bars { display:grid; grid-template-columns:120px 1fr 1fr 56px; gap:6px 10px; align-items:center; font-size:14px; }
  .bars .w { text-align:right; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .bars .neg, .bars .pos { height:12px; display:flex; }
  .bars .neg { justify-content:flex-end; border-right:1px solid var(--faint); }
  .bars .neg i { background:#C4C9D0; border-radius:2px 0 0 2px; }
  .bars .pos i { background:var(--red); border-radius:0 2px 2px 0; }
  .bars .n { color:var(--muted); font-variant-numeric:tabular-nums; font-size:13px; }
  .axis { display:grid; grid-template-columns:120px 1fr 1fr 56px; gap:10px; color:var(--faint); font-size:12px; margin-top:6px; }
  .axis span:nth-child(2) { text-align:right; }
  .rule { padding:12px 14px; border:1px solid var(--line); border-left:3px solid var(--rc); border-radius:6px; margin-bottom:10px; }
  .rule .title { font-weight:600; }
  .rule .cat { color:var(--muted); font-weight:400; }
  .rule .ev { margin-top:4px; font-size:14px; }
  .rule mark { background:#FCE4E7; color:var(--ink); padding:0 3px; border-radius:3px; }
  .rule .q { color:var(--muted); font-size:14px; margin-top:2px; }
  .agree { font-size:14px; margin-top:4px; color:var(--muted); }
  .refs { list-style:none; margin:0; padding:0; }
  .refs li { padding:10px 0; border-top:1px solid var(--line); }
  .refs li:first-child { border-top:0; padding-top:0; }
  .refs .prov { font-weight:600; }
  .refs .law { color:var(--muted); font-size:14px; }
  .refs p { margin:4px 0 0; font-size:14px; max-width:68ch; }
  .refs a { color:var(--red); font-size:13px; }
  .empty { color:var(--muted); font-size:14px; }
  .note { background:var(--panel); border-radius:6px; padding:10px 12px; font-size:13px; color:var(--muted); margin-top:12px; }
  footer { padding:16px 28px 22px; border-top:1px solid var(--line); color:var(--faint); font-size:12.5px; }
  @media (max-width:640px) {
    .page { margin:0; border-radius:0; border-left:0; border-right:0; }
    .verdict { grid-template-columns:1fr; } .verdict > div + div { border-left:0; border-top:1px solid var(--line); }
    .bars, .axis { grid-template-columns:90px 1fr 1fr 48px; }
  }
  @media print { body { background:#fff; } .page { margin:0; border:0; } a { color:var(--ink); } }
</style></head>
<body><div class="page">
  <div class="top">
    <span class="logo"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><circle cx="10" cy="10" r="6"/><path d="M15 15l5 5"/></svg></span>
    <span class="name">DarkPatternGuard</span>
    <span class="date">Audit report, {{ r.generated }}</span>
  </div>

  <div class="head">
    <h1>Text analysed</h1>
    <blockquote>“{{ r.text }}”</blockquote>
  </div>

  <div class="verdict">
    <div><div class="k">Detection</div>
      <div class="v">{{ "Likely a dark pattern" if r.stage1.label == 1 else "Not a dark pattern" }}</div>
      <div class="sub">{{ "%.0f"|format(100*r.stage1.p_dark) }}% likely</div></div>
    <div><div class="k">Type</div>
      <div class="v">{{ r.stage2.category if r.stage2 else "None" }}</div>
      <div class="sub">{% if r.stage2 %}{{ "%.0f"|format(100*r.stage2.confidence) }}% confidence{% else %}No category assigned{% endif %}</div></div>
    <div><div class="k">Review priority</div>
      <div class="v"><span class="pill" style="background:{{ risk_colour }}">{{ r.risk_level.split(" - ")[0] }}</span></div>
      <div class="sub">{{ (r.risk_level.split(" - ")[1] if " - " in r.risk_level else "No action needed")|capitalize }}</div></div>
  </div>

  {% if r.explanation %}
  <section>
    <h2>Which words drove the decision</h2>
    <p class="lead">LIME removes words at random and watches how the prediction changes. Red bars push towards “{{ r.explanation.class_name }}”, grey bars push away from it. This is a local approximation, not proof of cause.</p>
    <div class="bars">
      {% for w, v in r.explanation.weights %}
      {%- set pct = (100 * (v|abs) / lime_max) if lime_max else 0 -%}
      <span class="w">{{ w }}</span>
      <span class="neg">{% if v < 0 %}<i style="width:{{ pct }}%"></i>{% endif %}</span>
      <span class="pos">{% if v > 0 %}<i style="width:{{ pct }}%"></i>{% endif %}</span>
      <span class="n">{{ "%+.3f"|format(v) }}</span>
      {% endfor %}
    </div>
    <div class="axis"><span></span><span>away from</span><span>towards</span><span></span></div>
  </section>
  {% endif %}

  <section>
    <h2>Rule findings</h2>
    <p class="lead">Fixed, readable rules that look for known pressure tactics. They run alongside the model as a second opinion.</p>
    {% for h in r.rule_hits %}
    {%- set rc = "#7A4FD0" if h.ccpa else risk_colour -%}
    <div class="rule" style="--rc:{{ rc }}">
      <div class="title">{{ h.name }} <span class="cat">({{ h.category }})</span></div>
      <div class="ev">Matched {% for e in h.evidence %}<mark>{{ e }}</mark> {% endfor %}</div>
      <div class="q">To check: {{ h.question }}</div>
    </div>
    {% else %}
    <p class="empty">No rule matched this text.</p>
    {% endfor %}
    {% if r.model_rule_agreement is not none %}
    <div class="agree">{{ "The model and the rules point to the same type of pattern." if r.model_rule_agreement else "The model and the rules disagree on the type. Worth a closer look." }}</div>
    {% endif %}
  </section>

  <section>
    <h2>Regulations to review</h2>
    <p class="lead">Laws and guidance a reviewer may want to check this against. A match here is a prompt for human review, not a finding of a violation.</p>
    {% if r.regulatory_references %}
    <ul class="refs">
      {% for ref in r.regulatory_references %}
      <li><div class="prov">{{ ref.provision }}</div>
        <div class="law">{{ ref.law }}, relevant to {{ ref.for_category }}</div>
        <p>{{ ref.summary }}</p>
        <a href="{{ ref.source }}">Source</a></li>
      {% endfor %}
    </ul>
    {% else %}<p class="empty">None for this text.</p>{% endif %}
    {% if not r.ccpa_relevant %}
    <div class="note">California’s privacy-law rules on dark patterns (Civ. Code § 1798.140(h), (l) and 11 CCR § 7004) cover privacy choices and consent. Nothing in this text looked like a privacy choice.</div>
    {% endif %}
  </section>

  <footer>Model: {{ r.stage1.backend }}. {{ r.disclaimer }}</footer>
</div></body></html>
